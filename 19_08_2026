1. Three Parts of the Array (Codeforces 1380A)

#include <bits/stdc++.h>
using namespace std;
int main() {

    int n; cin >> n;
    vector<long long> a(n);
    for (int i = 0; i < n; i++) cin >> a[i];
    long long l = 0, r = n - 1, sumL = a[l], sumR = a[r], ans = 0;
    while (l < r) {
        if (sumL == sumR) ans = sumL;
        if (sumL <= sumR) sumL += a[++l];
        else sumR += a[--r];
    }
    cout << ans << "\n";
}



2. Boat Competition (Codeforces 1399C)

#include <bits/stdc++.h>
using namespace std;
int main() {
    int t; cin >> t;
    while (t--) {
        int n; cin >> n;
        vector<int> a(n);
        for (int i = 0; i < n; i++) cin >> a[i];
        sort(a.begin(), a.end());
        int res = 0;
        for (int s = 2; s <= 2 * n; s++) {
            int l = 0, r = n - 1, cnt = 0;
            while (l < r) {
                if (a[l] + a[r] == s) { cnt++; l++; r--; }
                else if (a[l] + a[r] < s) l++;
                else r--;
            }
            res = max(res, cnt);
        }
        cout << res << "\n";
    }
}




